          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// Проверяем, что ответ содержит массив из 100 постов
int responseSize = prev.getResponseDataAsString().length();
vars.put(&quot;responseSize&quot;, String.valueOf(responseSize));

// Если размер меньше 1000 байт — помечаем как ошибку
if (responseSize &lt; 1000) {
    prev.setSuccessful(false);
    log.warn(&quot;Ответ слишком короткий: &quot; + responseSize + &quot; байт&quot;);
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
