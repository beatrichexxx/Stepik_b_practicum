          <stringProp name="BeanShellSampler.query">import java.io.FileWriter;

// Файл для записи
String csvFile = &quot;id.csv&quot;;

// Берём данные из переменных и предыдущего ответа
String postId = vars.get(&quot;postId&quot;);
String randomUserId = vars.get(&quot;randomUserId&quot;);


// Открываем файл, пишем строку, закрываем
FileWriter fw = new FileWriter(csvFile, true);
fw.write(postId + &quot;,&quot; + randomUserId +  &quot;\n&quot;);
fw.close();

log.info(&quot;Записано: &quot; + postId+ &quot; &quot; +randomUserId);</stringProp>
